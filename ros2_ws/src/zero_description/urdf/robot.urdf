    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zero_description/meshes/propeller/left_motor_link.STL" />
      </geometry>
    </collision>
  </link>
  <!-- Fixed joint from hull to left propulsion body. -->
  <!-- 船体到左侧推进器本体的固定连接。 -->
  <joint name="left_motor_fixed_joint" type="fixed">
    <origin xyz="-0.111 0.202 0.04" rpy="1.5708 0 3.1416" />
    <parent link="zero_base_link" />
    <child link="left_motor_link" />
  </joint>

  <!-- Right propulsion/motor visual body; inertial values still need real verification. -->
  <!-- 右侧推进器/电机的可视化本体；惯性参数后续仍需实物核对。 -->
  <link name="right_motor_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia
        ixx="0"
        ixy="0"
        ixz="0"
        iyy="0"
        iyz="0"
        izz="0" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zero_description/meshes/propeller/right_motor_link.STL" />
      </geometry>
      <material name="motor_white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zero_description/meshes/propeller/right_motor_link.STL" />
      </geometry>
    </collision>
  </link>
  <!-- Fixed joint from hull to right propulsion body. -->
  <!-- 船体到右侧推进器本体的固定连接。 -->
  <joint name="right_motor_fixed_joint" type="fixed">
    <origin xyz="-0.111 -0.205 0.04" rpy="1.5708 0 3.1416" />
    <parent link="zero_base_link" />
    <child link="right_motor_link" />
  </joint>
</robot>
