<?xml version="1.0" encoding="utf-8"?>
<robot name="zero_usv_sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    This xacro is the ROS-side TF/robot_description companion for the phase-4
    Gazebo smoke model. The Gazebo physics/sensor model still lives in
    models/zero_usv/model.sdf.
  -->

  <xacro:property name="hull_size" value="1.20 0.55 0.20" />
  <xacro:property name="lidar_radius" value="0.045" />
  <xacro:property name="lidar_height" value="0.04" />
  <xacro:property name="lidar_xyz" value="0 0 0.20" />
  <xacro:property name="imu_size" value="0.07 0.05 0.03" />
  <xacro:property name="imu_xyz" value="0.15 0 0.13" />

  <link name="zero_base_link">
    <visual>
      <geometry>
        <box size="${hull_size}" />
      </geometry>
      <material name="hull_gray">
        <color rgba="0.86 0.88 0.90 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${hull_size}" />
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.12 0.14 0.16 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
    </collision>
  </link>
  <joint name="zero_lidar_fixed_joint" type="fixed">
    <origin xyz="${lidar_xyz}" rpy="0 0 0" />
    <parent link="zero_base_link" />
    <child link="lidar_link" />
  </joint>

  <!-- Match the physical ydlidar_ros2 default scan frame while keeping lidar_link as the mount frame. -->
  <link name="laser_frame" />
  <joint name="zero_laser_frame_fixed_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="lidar_link" />
    <child link="laser_frame" />
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size}" />
      </geometry>
      <material name="imu_blue">
        <color rgba="0.08 0.30 0.55 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${imu_size}" />
      </geometry>
    </collision>
  </link>
  <joint name="zero_imu_fixed_joint" type="fixed">
    <origin xyz="${imu_xyz}" rpy="0 0 0" />
    <parent link="zero_base_link" />
    <child link="imu_link" />
  </joint>
</robot>
