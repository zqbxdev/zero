<?xml version="1.0"?>
<sdf version="1.8">
  <model name="zero_usv">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <link name="zero_base_link">
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.82</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.46</iyy>
          <iyz>0</iyz>
          <izz>2.10</izz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <box>
            <size>1.20 0.55 0.20</size>
          </box>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <box>
            <size>1.20 0.55 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.86 0.88 0.90 1</ambient>
          <diffuse>0.86 0.88 0.90 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose relative_to="zero_base_link">-0.00015 -0.00040397 0.1277 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00006</iyy>
          <iyz>0</iyz>
          <izz>0.00008</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.14 0.16 1</ambient>
          <diffuse>0.12 0.14 0.16 1</diffuse>
        </material>
      </visual>
      <sensor name="zero_lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <!-- Approximate the real YDLIDAR X2: 360 deg, 0.10-8.0 m, 4-8 Hz, 3K samples/s. -->
        <!-- 近似真实 YDLIDAR X2：360 度、0.10-8.0 m、4-8 Hz、3K samples/s。 -->
        <update_rate>6</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <link name="imu_link">
      <pose relative_to="zero_base_link">0.15 0 0.13 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <collision name="imu_collision">
        <geometry>
          <box>
            <size>0.07 0.05 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="imu_visual">
        <geometry>
          <box>
            <size>0.07 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.30 0.55 1</ambient>
          <diffuse>0.08 0.30 0.55 1</diffuse>
        </material>
      </visual>
      <sensor name="zero_imu" type="imu">
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
      </sensor>
    </link>

    <link name="left_virtual_wheel_link">
      <!-- Virtual wheel links exist only to drive Gazebo DiffDrive for the USV hull. -->
      <!-- 虚拟轮 link 仅用于驱动 USV 船体的 Gazebo DiffDrive。 -->
      <pose relative_to="zero_base_link">0 0.2035 -0.13 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000013166666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000025</iyy>
          <iyz>0</iyz>
          <izz>0.000013166666667</izz>
        </inertia>
      </inertial>
      <collision name="left_virtual_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="right_virtual_wheel_link">
      <pose relative_to="zero_base_link">0 -0.2035 -0.13 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000013166666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000025</iyy>
          <iyz>0</iyz>
          <izz>0.000013166666667</izz>
        </inertia>
      </inertial>
      <collision name="right_virtual_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="left_virtual_wheel_joint" type="revolute">
      <parent>zero_base_link</parent>
      <child>left_virtual_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="right_virtual_wheel_joint" type="revolute">
      <parent>zero_base_link</parent>
      <child>right_virtual_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="zero_lidar_fixed_joint" type="fixed">
      <parent>zero_base_link</parent>
      <child>lidar_link</child>
    </joint>
    <frame name="laser_frame" attached_to="lidar_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <joint name="zero_imu_fixed_joint" type="fixed">
      <parent>zero_base_link</parent>
      <child>imu_link</child>
    </joint>

    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <!-- Topic, odometry, and limits mirror the ROS bridge and adapter contracts. -->
      <!-- topic、里程计和限幅与 ROS 桥接及适配器契约保持一致。 -->
      <left_joint>left_virtual_wheel_joint</left_joint>
      <right_joint>right_virtual_wheel_joint</right_joint>
      <wheel_separation>0.407</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/zero_usv/cmd_vel</topic>
      <odom_topic>/model/zero_usv/odometry</odom_topic>
      <tf_topic>/model/zero_usv/diff_drive_tf_unbridged</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>zero_base_link</child_frame_id>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
