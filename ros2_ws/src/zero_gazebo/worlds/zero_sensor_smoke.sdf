<?xml version="1.0"?>
<sdf version="1.8">
  <world name="zero_sensor_smoke">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic" />

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="water_plane_placeholder">
      <!-- Minimal water plane for sensor smoke checks, not a hydrodynamics model. -->
      <!-- 传感器 smoke 检查使用的最小水面，不是水动力模型。 -->
      <static>true</static>
      <link name="water_plane_link">
        <collision name="water_plane_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="water_plane_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.18 0.28 1</ambient>
            <diffuse>0.02 0.28 0.42 1</diffuse>
            <specular>0.02 0.04 0.06 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="scan_target_box">
      <static>true</static>
      <pose>2.0 0 0.35 0 0 0</pose>
      <link name="scan_target_link">
        <collision name="scan_target_collision">
          <geometry>
            <box>
              <size>0.35 0.35 0.70</size>
            </box>
          </geometry>
        </collision>
        <visual name="scan_target_visual">
          <geometry>
            <box>
              <size>0.35 0.35 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.18 0.08 1</ambient>
            <diffuse>0.85 0.18 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <!-- Spawn the packaged Zero USV model to exercise installed model:// lookup. -->
      <!-- 生成本包 Zero USV 模型，用于验证安装后的 model:// 查找。 -->
      <uri>model://zero_usv</uri>
      <pose>0 0 0.18 0 0 0</pose>
    </include>
  </world>
</sdf>
