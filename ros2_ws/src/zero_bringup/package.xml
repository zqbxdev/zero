<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zero_bringup</name>
  <version>0.1.0</version>
  <description>Launch orchestration for the Zero unmanned surface vessel.</description>
  <maintainer email="cnxwzy@gmail.com">cnxwzy</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>zero_description</exec_depend>
  <exec_depend>zero_hardware</exec_depend>
  <exec_depend>zero_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
